#!/usr/bin/env bash
# MCP stdio adapter for a local triago checkout — see bin/triago for why Node is pinned.
#
# Nothing may be written to stdout except MCP protocol frames, so every
# diagnostic here goes to stderr, which MCP clients treat as log output.
set -euo pipefail

self="${BASH_SOURCE[0]}"
while [ -L "$self" ]; do
  target="$(readlink "$self")"
  case "$target" in
    /*) self="$target" ;;
    *) self="$(dirname -- "$self")/$target" ;;
  esac
done
here="$(cd -- "$(dirname -- "$self")/.." && pwd)"

node_bin="${TRIAGO_NODE:-}"
if [ -z "$node_bin" ]; then
  newest="$(ls -d "$HOME"/.nvm/versions/node/v* 2>/dev/null | sort -V | tail -1 || true)"
  if [ -n "$newest" ] && [ -x "$newest/bin/node" ]; then
    node_bin="$newest/bin/node"
  else
    node_bin="$(command -v node || true)"
  fi
fi
[ -n "$node_bin" ] || { echo "triago-mcp: no node found (set TRIAGO_NODE)" >&2; exit 1; }

if [ ! -f "$here/dist/mcp.js" ]; then
  echo "triago-mcp: not built — run 'npm install && npm run build' in $here" >&2
  exit 1
fi
exec "$node_bin" "$here/dist/mcp.js" "$@"
